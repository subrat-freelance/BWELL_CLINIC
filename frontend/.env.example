# Copy to .env.local (dev) or set in your host's env settings (prod).

# The PUBLIC URL of the FastAPI backend — the browser calls this directly, so it must be
# reachable from the patient's/staff's device, not "localhost" in production.
#   dev:  NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
#   prod: NEXT_PUBLIC_API_URL=https://api.your-clinic-domain
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
