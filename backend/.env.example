# Copy to .env and fill in. .env is gitignored — never commit real values.
# ---------------------------------------------------------------------------

# REQUIRED. The JWT signing secret. Generate a fresh one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If this is left as the built-in dev value while ENV=production, the app REFUSES to start.
SECRET_KEY=

# Leave DATABASE_URL unset to use the SQLite fallback (./bwell.db)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bwell

# Signs every login token. Generate your own, never reuse this line:

# Set to "production" on the live server. This arms the SECRET_KEY safety check above.
# Leave unset / "dev" on your own machine.
ENV=production

# Comma-separated EXACT frontend origin(s) allowed to call the API. No trailing slash.
#   e.g. CORS_ORIGINS=https://bwell-clinic.vercel.app
CORS_ORIGINS=https://your-frontend-domain

# Break-glass account recovery key — the owner keeps this OFFLINE (in a safe), not on the
# computer. Powers the /recover page. Leave blank to disable self-service recovery entirely.
# A memorable high-entropy value, e.g. groups of four: ABCD-EFGH-JKMN-PQRS
RECOVERY_KEY=

# Where the SQLite database file lives. Default sits next to main.py.
# IMPORTANT: on any cloud host, point this at a PERSISTENT disk/volume, or every redeploy
# wipes all patient data. Example on a mounted volume at /data:
#   DATABASE_URL=sqlite:////data/bwell.db
DATABASE_URL=sqlite:///./bwell.db

# Leave DATABASE_URL unset to use the SQLite fallback (./bwell.db)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bwell
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001